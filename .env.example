# SRCI Environment Configuration
# Copy to .env and adjust for your environment

# Database
DATABASE_URL=postgresql://srci:srci@localhost:5432/srci

# API
SRCI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 17 — Auth & Tenancy
SRCI_AUTH_ENABLED=false
SRCI_DEFAULT_TENANT_ID=00000000-0000-4000-a000-000000000001
SRCI_OAUTH_ENABLED=false
SRCI_OAUTH_CLIENT_ID=
SRCI_OAUTH_CLIENT_SECRET=
SRCI_OAUTH_ISSUER=https://accounts.google.com

# LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SRCI_USE_LLM_EXPLANATIONS=true
SRCI_LLM_COST_PER_M_TOKENS=0.59

# Autonomy
SRCI_AUTONOMY_ENABLED=false
SRCI_AUTO_RCA_ON_INGEST=true
SRCI_POLL_INTERVAL_SEC=30
SRCI_POLL_BATCH_LIMIT=5
SRCI_RCA_WORKERS=2

# Demo API key (when SRCI_AUTH_ENABLED=true): srci_demo_key
